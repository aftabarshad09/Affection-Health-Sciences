# ── Admin login (local) ───────────────────────────────────────────────────
# The single admin account for the panel at /admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: a bcrypt hash instead of a plain password.
# ADMIN_PASSWORD_HASH=
# Secret used to sign admin login tokens — use a long random string.
JWT_SECRET=

# ── Email (order confirmations, status updates, contact form) ─────────────
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
RECEIVER_EMAIL=

# ── Image storage (Cloudinary — product images) ──────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Application ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Public site URL — used to build the order-tracking links in emails.
# Set to your live domain in production, e.g. https://www.affectionhealthsciences.com
APP_URL=https://www.affectionhealthsciences.com

# NOTE: The database is a local SQLite file (server/data/store.db) — there is
# NO external database to configure or keep awake. Seed the catalog once with:
#   cd server && npm run seed:sqlite
