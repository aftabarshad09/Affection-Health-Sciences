# ── Supabase ──────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Project Settings → Database → Connection string (URI, "Session" mode)
# Only needed to run `npm run migrate` — the app itself never uses this directly.
DATABASE_URL=

# ── Store Super Admin (one-time setup) ───────────────────────────────────
# Used once by `npm run migrate:admin` to create the first super_admin
# account in Supabase Auth. Safe to remove from .env after running it.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Email (transactional + contact form) ─────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
RECEIVER_EMAIL=

# ── Image Storage (Cloudinary) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WhatsApp order notifications (CallMeBot) ──────────────────────────────
# The business gets a WhatsApp message when an order is placed. Setup:
#   1. Add +34 644 51 95 23 to your phone contacts.
#   2. WhatsApp it: "I allow callmebot to send me messages" — it replies a key.
#   3. Set the two values below (phone = your number, intl digits, no + / no 0).
# If left blank, order placement still works; the WhatsApp step is just skipped.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ── Application ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Legacy admin login (retire once migrate:admin has run) ───────────────
# No longer used for authentication (admin login now goes through Supabase
# Auth) — safe to delete once you've confirmed the new login works.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=
# JWT_SECRET=
